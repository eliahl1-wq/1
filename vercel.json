{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/register",
      "destination": "/index.html"
    },
    {
      "source": "/lobby",
      "destination": "/index.html"
    },
    {
      "source": "/pre-game",
      "destination": "/index.html"
    },
    {
      "source": "/game",
      "destination": "/index.html"
    },
    {
      "source": "/slither-game",
      "destination": "/index.html"
    },
    {
      "source": "/surviv-game",
      "destination": "/index.html"
    },
    {
      "source": "/transactions",
      "destination": "/index.html"
    },
    {
      "source": "/profile",
      "destination": "/index.html"
    },
    {
      "source": "/gamemodes",
      "destination": "/index.html"
    },
    {
      "source": "/agar",
      "destination": "/index.html"
    },
    {
      "source": "/slither",
      "destination": "/index.html"
    },
    {
      "source": "/surviv",
      "destination": "/index.html"
    },
    {
      "source": "/rewards",
      "destination": "/index.html"
    },
    {
      "source": "/br-lobby",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/sandbox",
      "destination": "/index.html"
    },
    {
      "source": "/how-it-works",
      "destination": "/index.html"
    },
    {
      "source": "/faq",
      "destination": "/index.html"
    },
    {
      "source": "/tournaments",
      "destination": "/index.html"
    },
    {
      "source": "/tournaments/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/surviv-game",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/surviv",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    }
  ]
}
