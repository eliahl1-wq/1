# Backend API URL (production only — dev uses Vite proxy)
# VITE_API_URL=https://your-backend.railway.app

# Chainstack Solana Mainnet Global Node HTTPS endpoint.
# Vite variables are public in the browser, so keep endpoint access restrictions enabled in Chainstack.
VITE_SOLANA_RPC_URL=https://solana-mainnet.core.chainstack.com/your-node-access-token

# Mixpanel project token (https://mixpanel.com → Project Settings)
VITE_MIXPANEL_TOKEN=your-mixpanel-project-token

# Session Replay sampling 0–100 (default 100). Lower in production to save quota, e.g. 10
# VITE_MIXPANEL_RECORD_SESSIONS_PERCENT=100

# Only if your Mixpanel project is EU-hosted (Project Settings → Data Residency)
# VITE_MIXPANEL_API_HOST=https://api-eu.mixpanel.com

# AGAR token launch gate. Keep disabled and leave the mint empty before launch.
VITE_AGAR_ENABLED=false
VITE_AGAR_MINT=
VITE_AGAR_DECIMALS=9
VITE_AGAR_NAME=Agar
VITE_AGAR_SYMBOL=AGAR
VITE_AGAR_LOGO_URL=/agar-token-logo.svg

# Dormant provider defaults. They make no requests while launch gating is disabled.
VITE_AGAR_MARKET_PROVIDER=dexscreener
VITE_AGAR_SWAP_PROVIDER=jupiter-link

# Optional provider, polling, and explorer overrides.
# VITE_AGAR_MARKET_ENDPOINT=https://api.dexscreener.com/latest/dex/tokens/{mint}
# VITE_AGAR_CHART_URL=https://dexscreener.com/solana/{mint}?embed=1&theme=dark&trades=0&info=0
# VITE_AGAR_JUPITER_BUY_URL=https://jup.ag/swap/SOL-{mint}
# VITE_AGAR_JUPITER_SELL_URL=https://jup.ag/swap/{mint}-SOL
# VITE_AGAR_BALANCE_POLL_MS=15000
# VITE_AGAR_MARKET_POLL_MS=30000
# VITE_AGAR_AXIOM_URL=https://axiom.trade/t/{mint}?chain=sol
# VITE_AGAR_DEXSCREENER_URL=https://dexscreener.com/solana/{mint}
# VITE_AGAR_BIRDEYE_URL=https://birdeye.so/token/{mint}?chain=solana
